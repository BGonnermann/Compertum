{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "seal_id",
    "evaluation_id",
    "sequence",
    "previous_hash",
    "inputs_hash",
    "at",
    "sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "seal_id": {
      "type": "string"
    },
    "evaluation_id": {
      "type": "string"
    },
    "sequence": {
      "type": "integer"
    },
    "previous_hash": {
      "type": "string"
    },
    "inputs_hash": {
      "type": "string"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "sha256": {
      "type": "string"
    }
  }
}
