{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "path",
    "sha256",
    "bytes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_id": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bytes": {
      "type": "integer",
      "minimum": 0
    },
    "task_id": {
      "type": "string"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "code_hash": {
      "type": "string"
    },
    "input_hashes": {
      "type": "array"
    }
  }
}
