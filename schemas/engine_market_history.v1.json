{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "kind": {
      "const": "history"
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z]{1,5}(\\.[A-Z])?$"
    },
    "feed": {
      "enum": ["sip", "iex"]
    },
    "adjustment": {
      "enum": ["split", "raw"]
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "format": "project-path"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": ["path", "sha256"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "kind", "symbol", "feed", "adjustment", "chunks"],
  "additionalProperties": false
}
