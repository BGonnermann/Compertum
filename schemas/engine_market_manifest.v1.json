{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "symbol": {
      "type": "string",
      "enum": ["AAPL", "MSFT", "AMZN", "GOOGL", "META", "NVDA", "JPM", "XOM", "JNJ", "PG", "UNH", "HD", "SPY"]
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "format": "project-path"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": ["path", "sha256"],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "format": "project-path"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": ["path", "sha256"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "symbol", "snapshot", "evidence"],
  "additionalProperties": false
}
