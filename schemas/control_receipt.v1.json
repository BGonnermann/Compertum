{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "record_type": {
      "const": "ControlReceipt"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "state": {
      "enum": [
        "SUBMITTED",
        "PENDING",
        "CONFIRMED",
        "FAILED",
        "UNKNOWN",
        "CAPABILITY_UNAVAILABLE"
      ]
    },
    "evidence_label": {
      "enum": [
        "VERIFIED_PASS",
        "VERIFIED_FAIL",
        "UNVERIFIED",
        "PENDING_EXTERNAL_TIME",
        "CAPABILITY_UNAVAILABLE"
      ]
    },
    "confirmed": {
      "type": "boolean"
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "requested_at": {
      "type": "string",
      "format": "utc-time"
    },
    "observed_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "utc-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer",
          "enum": [
            0,
            2,
            3,
            4,
            5,
            6
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "format": "uuid"
          },
          "path": {
            "type": "string",
            "format": "project-path",
            "maxLength": 1024
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "artifact_id",
          "path",
          "size_bytes",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1024
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "request_id",
    "action",
    "target",
    "state",
    "evidence_label",
    "confirmed",
    "generation",
    "requested_at",
    "observed_at",
    "exit_code",
    "reason",
    "artifacts"
  ],
  "additionalProperties": false
}
