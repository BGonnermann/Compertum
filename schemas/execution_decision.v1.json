{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "scope": {
      "const": "DETERMINISTIC_FAKE"
    },
    "account_alias": {
      "type": "string",
      "pattern": "^fake-[a-z0-9_-]{1,48}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "currency": {
      "const": "USD"
    },
    "record_type": {
      "const": "ExecutionDecision"
    },
    "kind": {
      "enum": [
        "STRATEGY",
        "CONTROL"
      ]
    },
    "evaluated_at": {
      "type": "string",
      "format": "utc-time"
    },
    "allowed": {
      "type": "boolean"
    },
    "reasons": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z_]+$"
      }
    },
    "maximum_quantity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "reserved_notional": {
      "type": "string",
      "pattern": "^-?\\d{1,32}(?:\\.\\d{1,32})?$"
    },
    "snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "intent_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "financial_accepted": {
      "const": false
    },
    "dependencies": {
      "type": "object",
      "maxProperties": 4,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "propertyNames": {
        "enum": [
          "calendar",
          "inputs",
          "plan",
          "authorization",
          "start"
        ]
      }
    },
    "intent_notional_cap": {
      "type": "string",
      "pattern": "^-?\\d{1,32}(?:\\.\\d{1,32})?$"
    },
    "risk_nav": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?\\d{1,32}(?:\\.\\d{1,32})?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "daily_loss": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?\\d{1,32}(?:\\.\\d{1,32})?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "drawdown": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?\\d{1,32}(?:\\.\\d{1,32})?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "existing_projected_exposure": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {
        "type": "string",
        "pattern": "^-?\\d{1,32}(?:\\.\\d{1,32})?$"
      }
    },
    "existing_projected_gross": {
      "type": "string",
      "pattern": "^-?\\d{1,32}(?:\\.\\d{1,32})?$"
    },
    "unreserved_cash": {
      "type": "string",
      "pattern": "^-?\\d{1,32}(?:\\.\\d{1,32})?$"
    },
    "client_order_id": {
      "type": "string",
      "pattern": "^cmp-[0-9a-f]{40}$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authorization_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "scope",
    "account_alias",
    "generation",
    "currency",
    "record_type",
    "kind",
    "evaluated_at",
    "allowed",
    "reasons",
    "maximum_quantity",
    "reserved_notional",
    "snapshot_sha256",
    "intent_sha256",
    "financial_accepted",
    "dependencies"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
